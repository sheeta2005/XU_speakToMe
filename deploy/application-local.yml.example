# 10/20：复制到仓库根目录 application-local.yml，仅保存在本机，不提交。
spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:13306/speak_to_me?characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: speak_to_me
    password: ${MYSQL_PASSWORD:}
  data:
    redis:
      host: 127.0.0.1
      port: 16379
      password: ${REDIS_PASSWORD:}
wx:
  miniapp:
    appid: ${WX_APPID:}
    secret: ${WX_SECRET:}
security:
  aes:
    key: ${AES_KEY:}
