<view class="page-root" data-theme="{{theme}}">
  <!-- 菜品信息 -->
  <view class="dish-head card" wx:if="{{dish}}">
    <view class="dish-title">
      <view class="dish-name">{{dish.name}}</view>
      <view class="dish-price" wx:if="{{dish.price !== null && dish.price !== undefined}}">￥{{dish.price}}</view>
    </view>
    <view class="dish-desc text-secondary" wx:if="{{dish.description}}">{{dish.description}}</view>

    <view class="dish-score-row">
      <view class="score-big">{{dish.avgRating || '0.0'}}</view>
      <view class="score-meta">
        <view class="stars">
          <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star {{dish.avgRating >= item ? 'star-on' : ''}}">★</text>
        </view>
        <view class="text-secondary">{{dish.ratingCount || 0}} 条点评</view>
      </view>
    </view>

    <!-- 评分分布 -->
    <view class="dist-list">
      <view wx:for="{{distribution}}" wx:key="rating" class="dist-row">
        <view class="dist-label">{{item.rating}}星</view>
        <view class="dist-bar">
          <view class="dist-fill" style="width: {{item.percent}}%"></view>
        </view>
        <view class="dist-count">{{item.count}}</view>
      </view>
    </view>
  </view>

  <!-- 写点评 -->
  <view class="write-entry card" bindtap="openWrite">
    <text wx:if="{{!showWrite}}">✎ 写点评（评分 + 10-200 字评论）</text>
  </view>
  <view class="write-panel card" wx:if="{{showWrite}}">
    <view class="rate-row">
      <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
            class="rate-star {{rating >= item ? 'star-on' : ''}}"
            data-r="{{item}}" bindtap="pickRating">★</text>
    </view>
    <textarea class="write-input" placeholder="说说这道菜的味道、分量、性价比…（10-200 字）"
              maxlength="200" value="{{content}}" bindinput="onInput"></textarea>
    <button class="btn-primary submit-btn" loading="{{submitting}}" bindtap="submit">提交点评</button>
    <view class="text-secondary write-count">{{content.length}}/200</view>
  </view>

  <!-- 评论列表 -->
  <view class="review-section">
    <view class="review-title">全部点评（{{total}}）</view>
    <view wx:for="{{reviews}}" wx:key="id" class="review-item card">
      <view class="review-head">
        <view class="review-user">
          <image class="avatar" wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" />
          <view class="avatar avatar-fallback" wx:else>{{item.nickname[0]}}</view>
          <view class="review-nick">{{item.nickname}}</view>
        </view>
        <view class="review-stars">
          <text wx:for="{{[1,2,3,4,5]}}" wx:for-item="r" wx:key="*this"
                class="star {{item.rating >= r ? 'star-on' : ''}}">★</text>
        </view>
      </view>
      <view class="review-content">{{item.content}}</view>
      <view class="review-foot">
        <view class="review-time text-secondary">{{item.createdAt}}</view>
        <view class="review-audit text-secondary" wx:if="{{item.auditStatus === 3}}">审核中，仅自己可见</view>
        <view class="review-del" wx:if="{{item.deletable}}" data-id="{{item.id}}" catchtap="remove">删除</view>
      </view>
    </view>
    <view class="list-empty text-secondary" wx:if="{{reviews.length === 0}}">还没有点评，来当第一个吧</view>
    <view class="load-more text-secondary" wx:if="{{hasMore}}">上拉加载更多</view>
  </view>
</view>
