.page-root {
  padding: 32rpx 32rpx 48rpx;
}

.stall-block {
  margin-bottom: 40rpx;
}

.stall-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.stall-name {
  font-size: 36rpx;
  font-weight: 700;
}

.stall-meta {
  margin-left: 16rpx;
  font-size: 24rpx;
}

.dish-list {
  display: flex;
  flex-direction: column;
}

.dish-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}

.dish-main {
  flex: 1;
  margin-right: 24rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
}

.dish-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.dish-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.dish-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-accent);
}

.dish-rating {
  font-size: 26rpx;
  color: var(--color-accent);
  margin-top: 8rpx;
}

.dish-rating .star {
  color: var(--color-star);
}

.dish-none {
  font-size: 22rpx;
  margin-top: 8rpx;
}

.dish-empty,
.list-empty {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
}
