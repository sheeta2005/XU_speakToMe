.page-root {
  padding: 32rpx 32rpx 48rpx;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
}

.page-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.site-list {
  display: flex;
  flex-direction: column;
}

.site-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.site-name {
  font-size: 34rpx;
  font-weight: 600;
}

.site-tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}

.tag-inner {
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.tag-outer {
  color: var(--color-accent);
  background: var(--color-accent-soft);
}

.site-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.site-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.site-rating {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-accent);
}

.site-count {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.site-arrow {
  font-size: 36rpx;
  margin-top: 6rpx;
}

.list-empty {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
}
