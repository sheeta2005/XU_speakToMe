.page-root {
  padding: 32rpx 32rpx 48rpx;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
}

.page-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.profile-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
}

.profile-head {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-fallback {
  line-height: 96rpx;
  background: var(--color-bg);
  color: var(--color-primary);
  text-align: center;
  font-size: 40rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  word-break: break-all;
}

.campus-name {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.field-label {
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.nickname-input {
  padding: 20rpx;
  background: var(--color-bg);
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  color: var(--color-text);
}

.save-button {
  margin-top: 24rpx;
}

.menu-card {
  padding: 0 24rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  font-size: 26rpx;
}

.state-card,
.state-message {
  padding: 64rpx 24rpx;
  text-align: center;
}

.link-action {
  margin-top: 24rpx;
  color: var(--color-primary);
}
