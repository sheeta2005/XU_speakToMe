.page-root {
  padding: 32rpx 32rpx 48rpx;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
}

.page-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.review-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.review-head,
.review-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-name {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  word-break: break-all;
}

.audit-label {
  flex-shrink: 0;
  font-size: 22rpx;
}

.review-rating {
  margin-top: 16rpx;
  color: var(--color-star);
  font-size: 26rpx;
}

.review-content {
  margin-top: 16rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.review-foot {
  margin-top: 24rpx;
  font-size: 22rpx;
}

.delete-button {
  margin: 0 0 0 16rpx;
  flex-shrink: 0;
  background: var(--color-bg);
  color: var(--color-danger);
}

.list-state {
  padding: 48rpx 24rpx;
  font-size: 24rpx;
  text-align: center;
}

.retry-action {
  margin-top: 24rpx;
  color: var(--color-primary);
}
