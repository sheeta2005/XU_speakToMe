.page-root {
  padding: 48rpx 32rpx;
}

.page-header {
  margin-bottom: 40rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
}

.page-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.campus-list {
  display: flex;
  flex-direction: column;
}

.campus-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  border: 3rpx solid transparent;
}

.campus-item-active {
  border-color: var(--color-primary);
}

.campus-name {
  font-size: 34rpx;
  font-weight: 600;
}

.campus-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 28rpx;
  text-align: center;
  line-height: 44rpx;
}

.campus-empty {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
}
