.page-root {
  padding: 32rpx 32rpx 48rpx;
}

.page-header {
  margin-bottom: 28rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
}

.page-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.period-switch {
  display: flex;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.period-option {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 12rpx;
  color: var(--color-text-secondary);
  text-align: center;
  font-size: 26rpx;
}

.period-option.active {
  color: var(--color-text);
  background: var(--color-bg);
  box-shadow: inset 0 0 0 2rpx var(--color-primary);
  font-weight: 600;
}

.period-option.disabled {
  opacity: 0.6;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.rank-number {
  width: 56rpx;
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.rank-top {
  color: var(--color-accent);
}

.rank-main {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.dish-name {
  overflow: hidden;
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-location,
.dish-meta {
  overflow: hidden;
  margin-top: 8rpx;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-rating {
  min-width: 84rpx;
  text-align: right;
}

.rating-value {
  color: var(--color-accent);
  font-size: 34rpx;
  font-weight: 700;
}

.rating-label {
  margin-top: 4rpx;
  font-size: 20rpx;
}

.state-card {
  padding: 48rpx 32rpx;
  text-align: center;
}

.state-message {
  padding: 72rpx 20rpx;
  font-size: 26rpx;
  text-align: center;
}

.state-card .state-message {
  padding: 0;
}

.retry-action {
  margin-top: 24rpx;
  color: var(--color-primary);
  font-size: 26rpx;
}
