/* 10/16：运营页面沿用全局主题，长评论和错误信息允许自然换行。 */
.page-root { padding: 32rpx 32rpx 64rpx; min-height: 100vh; box-sizing: border-box; }
.page-title { font-size: 40rpx; font-weight: 700; margin-bottom: 24rpx; }
.entry, .editor { padding: 28rpx; margin: 24rpx 0; overflow-wrap: anywhere; }
.editor { border: 2rpx solid var(--color-primary); }
.entry-title { font-size: 30rpx; font-weight: 600; }
.content { white-space: pre-wrap; line-height: 1.7; margin: 16rpx 0; }
.text-secondary { font-size: 24rpx; }
.actions, .tabs { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 24rpx 0; }
.actions button, .tabs button { margin: 0; }
.tabs button { flex: 1; font-size: 28rpx; }
.active, .link, .filter { color: var(--color-primary); }
.filter, .field-label { padding: 20rpx 0; }
.field-label { font-size: 26rpx; }
.state { text-align: center; padding: 40rpx 0; }
.error { color: var(--color-danger); padding: 20rpx 0; }
input, textarea, .picker-field { width: 100%; box-sizing: border-box; border: 1rpx solid var(--color-border); border-radius: 12rpx; padding: 20rpx; color: var(--color-text); background: var(--color-card); }
input { height: 88rpx; }
textarea { height: 180rpx; }
button { color: var(--color-text); background: var(--color-card); font-size: 28rpx; }
.link { margin-top: 20rpx; }
